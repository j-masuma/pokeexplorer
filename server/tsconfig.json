{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": false,

    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    "verbatimModuleSyntax": false,
    "isolatedModules": true,

    "types": ["node"]
  }
}